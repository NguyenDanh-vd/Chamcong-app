{
  "expo": {
    "name": "chamcong-app",
    "slug": "chamcong-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "chamcongapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourname.chamcongapp",
      "infoPlist": {
        "NSCameraUsageDescription": "Ứng dụng cần truy cập Camera để chấm công và chụp ảnh đại diện.",
        "NSPhotoLibraryUsageDescription": "Ứng dụng cần truy cập Thư viện ảnh để cập nhật avatar.",
        "NSLocationWhenInUseUsageDescription": "Ứng dụng cần vị trí để xác thực địa điểm chấm công.",
        "NSMicrophoneUsageDescription": "Ứng dụng cần truy cập Microphone (nếu quay video)."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.yourname.chamcongapp",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép IT-Global truy cập Camera để chấm công khuôn mặt và chụp ảnh đại diện."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Cho phép IT-Global truy cập Vị trí để xác thực địa điểm chấm công."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép IT-Global truy cập Thư viện ảnh để bạn chọn ảnh đại diện."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Cho phép IT-Global lưu ảnh hoặc file vào thiết bị.",
          "savePhotosPermission": "Cho phép lưu file xuất Excel vào thiết bị."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "48015d7a-af32-4f61-8719-e43241894a8f"
      }
    }
  }
}
